# KIS OpenAPI Credentials (Injected via Kubernetes ConfigMap/Secret in production)
APP_KEY=YOUR_KIS_APP_KEY
APP_SECRET=YOUR_KIS_APP_SECRET

# Target Stock Codes (comma-separated, max 40 per KIS WebSocket session)
TARGET_CODES=005930,000660,035420

# Kafka Broker Configuration
BOOTSTRAP_SERVERS=kafka-service:9092
TOPIC_NAME=stock_Order_Info
